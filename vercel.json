{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/report", "destination": "/api/report" },
    { "source": "/water-hardness", "destination": "/api/water-hardness" },
    { "source": "/water-hardness/:slug", "destination": "/api/water-hardness?slug=:slug" },
    { "source": "/hardest-water-cities", "destination": "/api/hardest-water-cities" },
    { "source": "/methodology", "destination": "/api/methodology" },
    { "source": "/landlord-hard-water", "destination": "/api/landlord-hard-water" },
    { "source": "/the-wrong-number-problem", "destination": "/api/the-wrong-number-problem" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: www.facebook.com; connect-src 'self' www.facebook.com vitals.vercel-insights.com; frame-src 'none'"
        }
      ]
    }
  ]
}
